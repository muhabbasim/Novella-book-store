NODE_ENV=test

# Dedicated test database. The name MUST contain "test".
# Never use your development/production database name (e.g. neondb).
#
# Option A — local Postgres (when you install it later):
# DATABASE_URL=postgresql://YOUR_USER@localhost:5432/ecommerce_test
#
# Option B — separate Neon database (no Docker):
# 1. npm run test:db:create
#    (creates ecommerce_test from your .env URL, does not wipe neondb)
# 2. Keep ALLOW_REMOTE_TEST_DB=true below
DATABASE_URL=postgresql://USER:PASSWORD@HOST/ecommerce_test
ALLOW_REMOTE_TEST_DB=true

SESSION_SECRET=test_session_secret_not_for_production
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_test_mock
FRONTEND_URL=http://localhost:5173
PORT=5001
